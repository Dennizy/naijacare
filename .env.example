# ---- Browser (public, set in Netlify) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_OSRM_URL=https://routing.openstreetmap.de
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
# MMS ONNX models. Xenova/mms-tts-eng and Xenova/mms-tts-yor exist. Hausa and Igbo ONNX ports were NOT confirmed: use your own converted repos.
VITE_MMS_HAU=Xenova/mms-tts-hau
VITE_MMS_IBO=Xenova/mms-tts-ibo
VITE_MODEL_HOST=            # optional: your own host for model files
VITE_WHISPER_MODEL=Xenova/whisper-base

# ---- Local scripts only (run on your computer, NEVER put in Netlify or the browser) ----
# SUPABASE_URL, SUPABASE_SERVICE_KEY, ADMIN_PASSWORD  -> scripts/create-admin.mjs, scripts/upload-clips.mjs
